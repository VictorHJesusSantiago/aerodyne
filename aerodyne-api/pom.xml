<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.aerodyne</groupId>
    <artifactId>aerodyne</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>aerodyne-api</artifactId>
  <packaging>jar</packaging>

  <name>Aerodyne :: API</name>
  <description>
    The Spring Boot application: REST endpoints for planning a flight, retrieving an OFP and
    exchanging CPDLC-style messages, JPA persistence of navigation data and flight plans on
    PostGIS, and the Flyway migrations that create the schema.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.aerodyne</groupId>
      <artifactId>aerodyne-geo</artifactId>
    </dependency>
    <dependency>
      <groupId>io.aerodyne</groupId>
      <artifactId>aerodyne-navdata</artifactId>
    </dependency>
    <dependency>
      <groupId>io.aerodyne</groupId>
      <artifactId>aerodyne-weather</artifactId>
    </dependency>
    <dependency>
      <groupId>io.aerodyne</groupId>
      <artifactId>aerodyne-performance</artifactId>
    </dependency>
    <dependency>
      <groupId>io.aerodyne</groupId>
      <artifactId>aerodyne-routing</artifactId>
    </dependency>
    <dependency>
      <groupId>io.aerodyne</groupId>
      <artifactId>aerodyne-dispatch</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-spatial</artifactId>
    </dependency>
    <dependency>
      <groupId>org.locationtech.jts</groupId>
      <artifactId>jts-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
