  <artifactId>aerodyne-performance</artifactId>
  <packaging>jar</packaging>

  <name>Aerodyne :: Performance</name>
  <description>
    Aircraft performance: an aircraft type model with climb, cruise and descent tables, fuel
    and time integration along a route against forecast winds, the regulatory fuel policy, and
    weight and balance with a centre-of-gravity envelope check.
  </description>

